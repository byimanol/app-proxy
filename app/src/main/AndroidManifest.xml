<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.BIND_VPN_SERVICE"/>
    <application android:label="Socks5Setter" android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name=".ConfigActivity" android:exported="false"/>
        <receiver android:name=".SetProxyReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.socks5setter.SET_PROXY"/>
            </intent-filter>
        </receiver>
        <receiver android:name=".GetProxyReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.socks5setter.GET_PROXY"/>
            </intent-filter>
        </receiver>
        <service
            android:name=".Socks5VpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.VpnService"/>
            </intent-filter>
        </service>
        <service
            android:name="net.typeblog.socks.SocksVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.VpnService"/>
            </intent-filter>
        </service>
    </application>
</manifest>